<!-- The htmlform code for Initial estimated delivery date and gestational age -->
<div id="edd-and-ga-widget">
    <subform path="configuration/pih/subforms/edd.js"/>
    <subform path="configuration/pih/subforms/est-delivery-date-followup.js"/>
    <subform path="configuration/pih/subforms/est-delivery-date-ga.css"/>

    <div class="edd-div">
        <!-- Visit date / encounterDate -->
        <div class="field-group">
            <div class="field-label">Visit date</div>
            <div class="field-value-row" id="visitDateDisplay"></div>
            <div class="field-caption">Encounter date</div>
        </div>

        <div class="field-group hidden" id="lastPeriodDateGroup">
            <div class="field-label">Last menstrual period</div>
            <div class="field-value-row">
                <span id="lastPeriodDate" class="obs-field value-input">
                    <span id="lastPeriodDateValue" class="value"></span>
                </span>
            </div>
            <div id="lastLMPCaption" class="field-caption hidden">
                <span id="lastLMPFormName"></span>&nbsp;
                <i class="icon-time small"></i><span id="lastLMPobsDateTime"></span>&nbsp;
                <i class="icon-map-marker small"></i><span id="lastLMPencLocation"></span>
            </div>
        </div>

        <div class="field-group" id="estimatedGaGroup">
            <div class="field-label">
                <uimessage code="Estimated gestational age (weeks)"/>
            </div>
            <div class="field-value-row value estimated-gestational-age-value" id="gestationalAge">
                <obs conceptId="CIEL:1438" showUnits="true" class="value-input" id="estimatedGestationalAge"/>
            </div>
            <div id="lastGACaption" class="field-caption hidden">
                <span id="lastGAText">Last recorded GA value: </span>
                <span id="lastGAValue"></span>&nbsp;weeks
                <i class="icon-time small"></i><span id="lastGAobsDateTime"></span>&nbsp;
                <span id="lastGAFormName"></span>&nbsp;
                <i class="icon-map-marker small"></i><span id="lastGAencLocation"></span>
            </div>
        </div>

        <div class="field-group" id="eddGroup">
            <div class="field-label">
                <uimessage code="pihcore.pregnancy.dueDate"/>
            </div>
            <div class="field-value-row value" id="estimatedEddDiv">
                <obs id="edd" conceptId="CIEL:5596" allowFutureDates="true" allowPastDates="true" class="value-input"/>
            </div>
            <div id="lastEDDCaption" class="field-caption hidden">
                <span id="lastEDDText">Last recorded EDD value: </span>
                <span id="lastEDDValue"></span>&nbsp;
                <i class="icon-time small"></i><span id="lastEDDobsDateTime"></span>&nbsp;
                <span id="lastEDDFormName"></span>&nbsp;
                <i class="icon-map-marker small"></i><span id="lastEDDencLocation"></span>
            </div>
        </div>
        <div class="field-group hidden" id="calculatedEddGroup">
            <div class="field-label">
                <uimessage code="pihcore.calculatedEstimatedDeliveryDate"/>:&#160;
                <span class="badge-calculated">Calculated</span>
            </div>
            <div class="field-value-row calculated value calculated-edd" id="calculated-edd"></div>
            <div class="field-caption">LMP + 280 days (Naegele's rule)</div>
        </div>

        <!-- Manual EDD entry, shown only when LMP is unknown - mirrors the real
             subform's two-columns layout (lastPeriodDate | edd), where a provider
             can enter the due date directly instead of the LMP -->
        <div class="field-group hidden" id="manualEddGroup">
            <div class="field-label">Estimated delivery date</div>
            <div class="field-value-row">
                <input type="date" class="value-input" id="manualEdd"/>
            </div>
            <div class="field-caption">Entered by provider</div>
        </div>

        <div class="field-group hidden" id="gaGroup">
            <div class="field-label">
                <uimessage code="pihcore.calculatedGestationalAge"/>:&#160;
                <span class="badge-calculated">Calculated</span>
            </div>
            <div class="field-value-row calculated value calculated-gestational-age-value" id="calculated-gestational-age-value"></div>
            <div class="field-caption">From LMP to visit date</div>
        </div>

    </div>
</div>
